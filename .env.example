# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- public
# Safe to ship in the browser bundle. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase renamed the anon key to the "publishable" key. Newer projects issue
# that name instead, and either is accepted — set whichever your project shows.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- server
# Bypasses row level security completely. Server-side only: it must never be
# imported into a "use client" file, and `npm run build` fails if it is.
# Rotate immediately if it is ever pasted anywhere it does not belong.
SUPABASE_SERVICE_ROLE_KEY=

# Newer projects call the same thing the "secret" key, which is what the
# Supabase-Vercel integration exports. Either is accepted; set only one.
# SUPABASE_SECRET_KEY=

# Shared secret the AI intake bot sends as the `x-intake-secret` header on
# POST /api/reports. Generate with: openssl rand -base64 32
INTAKE_SECRET=
